{
  "name": "@pin-clutch/rest-api",
  "version": "0.0.1",
  "main": "source/index.ts",
  "scripts": {
    "develop": "npx tsx watch --env-file=.env source/index.ts",
    "clean": "npm run clean:database & npm run clean:images",
    "clean:database": "rimraf --glob ./database/*.sqlite",
    "clean:images": "rimraf --glob ./images/pins/*.png"
  },
  "dependencies": {
    "body-parser": "2.2.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "pino": "10.1.1",
    "pino-http": "11.0.0",
    "stytch": "13.2.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/node": "22.5.4",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.2",
    "tsx": "4.21.0",
    "rimraf": "6.0.1"
  }
}